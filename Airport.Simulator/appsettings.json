{
  "FlightTimeoutConfiguration": {
    "Timeout": 1101
  },
  "FlightEndPointsConfiguration": {
    "Departure": "/api/Flights/AddDeparture",
    "Landing": "/api/Flights/AddLanding",
    "Flights": "/api/Flights",
    "Start": "/api/Airport/Start",
    "BaseUrl": "https://airport.api.elitzafan.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      },
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": false,
        "TimestampFormat": "HH:mm:ss.fff "
      }
    }
  },
  "AllowedHosts": "*"
}